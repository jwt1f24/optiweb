{
    "name": "OptiWeb",
    "description": "Automatically clean up memory usage by discarding the long line of inactive tabs!",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
        "tabs",
        "storage",
        "system.memory",
        "alarms",
        "notifications",
        "downloads"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "32": "images/icon32.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "icons": {
        "16": "images/icon16.png",
        "32": "images/icon32.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "commands": {
        "_execute_action": {
            "description": "Activate Extension"
        },
        "toggle-extension": {
            "description": "Toggle Extension"
        },
        "run-optimize": {
            "description": "Run Optimization"
        }
    }
}